# Stringa di connessione Postgres del progetto Supabase "recupera"
# (Dashboard Supabase > Connect > Session pooler). Mai committare il valore reale.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>.pooler.supabase.com:5432/postgres

# Segreto per firmare i token degli admin: genera con `openssl rand -hex 32`
JWT_SECRET=

PORT=3001
